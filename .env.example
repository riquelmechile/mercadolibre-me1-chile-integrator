# Runtime
APP_HOST=127.0.0.1
APP_PORT=8787
SQLITE_PATH=./data/me1-integrator.sqlite
LOG_LEVEL=info
# Required for any non-loopback bind (e.g. APP_HOST=0.0.0.0)
APP_API_KEY=

# Safety gates
ME1_CERTIFIED=false
ENABLE_DEV_ROUTES=false

# Secret references are resolved from environment names derived from credentialRef.
# Example credentialRef: starken-exampleco -> SECRET_STARKEN_EXAMPLECO
# SECRET_STARKEN_EXAMPLECO=
# SECRET_BLUEEXPRESS_EXAMPLECO=
# SECRET_CHILEXPRESS_EXAMPLECO=
# SECRET_MELI_EXAMPLECO=

# Optional official-contract endpoint configuration. Keep blank until verified.
STARKEN_BASE_URL=
STARKEN_QUOTE_PATH=
STARKEN_CREATE_SHIPMENT_PATH=
STARKEN_TRACKING_PATH=

BLUEEXPRESS_BASE_URL=
BLUEEXPRESS_QUOTE_PATH=
BLUEEXPRESS_CREATE_SHIPMENT_PATH=
BLUEEXPRESS_TRACKING_PATH=

CHILEXPRESS_BASE_URL=
CHILEXPRESS_QUOTE_PATH=
CHILEXPRESS_CREATE_SHIPMENT_PATH=
CHILEXPRESS_TRACKING_PATH=

# Mercado Libre official API base; no credentials are stored in this repo.
MELI_API_BASE_URL=https://api.mercadolibre.com
