# Runtime
APP_HOST=127.0.0.1
APP_PORT=8787
SQLITE_PATH=./data/me1-integrator.sqlite
LOG_LEVEL=info
# Required for any non-loopback bind (e.g. APP_HOST=0.0.0.0)
APP_API_KEY=

# Safety gates
ME1_CERTIFIED=false
ENABLE_DEV_ROUTES=false

# Optional controlled-shipment PREVIEW runtime (read-only quote on disabled carrier).
# Configure all fields together for a short-lived loopback-only runtime. Never store the raw preview secret here.
CONTROLLED_SHIPMENT_PREVIEW_ID=
CONTROLLED_SHIPMENT_PREVIEW_TENANT_ID=
CONTROLLED_SHIPMENT_PREVIEW_PROVIDER=
CONTROLLED_SHIPMENT_PREVIEW_SECRET_SHA256=
CONTROLLED_SHIPMENT_PREVIEW_ISSUED_AT=
CONTROLLED_SHIPMENT_PREVIEW_EXPIRES_AT=

# Optional controlled-shipment APPROVAL runtime (exact-payload one-shot create).
# Configure only after human approval. Never store the raw approval secret here.
CONTROLLED_SHIPMENT_APPROVAL_ID=
CONTROLLED_SHIPMENT_TENANT_ID=
CONTROLLED_SHIPMENT_PROVIDER=
CONTROLLED_SHIPMENT_PAYLOAD_SHA256=
CONTROLLED_SHIPMENT_SECRET_SHA256=
CONTROLLED_SHIPMENT_ISSUED_AT=
CONTROLLED_SHIPMENT_EXPIRES_AT=

# Secret references are resolved from environment names derived from credentialRef.
# Example credentialRef: starken-exampleco -> SECRET_STARKEN_EXAMPLECO
# SECRET_STARKEN_EXAMPLECO=
# SECRET_BLUEEXPRESS_EXAMPLECO=
# SECRET_CHILEXPRESS_EXAMPLECO=
# SECRET_MELI_EXAMPLECO=

# Optional official-contract endpoint configuration. Keep blank until verified.
STARKEN_BASE_URL=
STARKEN_QUOTE_PATH=
STARKEN_CREATE_SHIPMENT_PATH=
STARKEN_TRACKING_PATH=

BLUEEXPRESS_BASE_URL=
BLUEEXPRESS_QUOTE_PATH=
BLUEEXPRESS_CREATE_SHIPMENT_PATH=
BLUEEXPRESS_TRACKING_PATH=

CHILEXPRESS_BASE_URL=
CHILEXPRESS_QUOTE_PATH=
CHILEXPRESS_CREATE_SHIPMENT_PATH=
CHILEXPRESS_TRACKING_PATH=

# Mercado Libre official API base; no credentials are stored in this repo.
MELI_API_BASE_URL=https://api.mercadolibre.com

# Optional observation-only controlled shipment runtime (loopback only; all-or-none; max 60 min).
# Keep raw observation secret outside env/config and send it only in x-controlled-shipment-observation.
CONTROLLED_SHIPMENT_OBSERVATION_ID=
CONTROLLED_SHIPMENT_OBSERVATION_TENANT_ID=
CONTROLLED_SHIPMENT_OBSERVATION_PROVIDER=
CONTROLLED_SHIPMENT_OBSERVATION_SHIPMENT_ID=
CONTROLLED_SHIPMENT_OBSERVATION_SECRET_SHA256=
CONTROLLED_SHIPMENT_OBSERVATION_ISSUED_AT=
CONTROLLED_SHIPMENT_OBSERVATION_EXPIRES_AT=
